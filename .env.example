# ============================================================
# Touse — Environment Variables
# Copy to:  .env           → FastAPI  (api/ directory)
#           web/.env.local → Next.js  (web/ directory)
# ============================================================

# ── Clerk Authentication ─────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX

# Frontend API URL shown in Clerk dashboard (e.g. https://example.clerk.accounts.dev)
CLERK_JWT_ISSUER=https://YOUR_CLERK_FRONTEND_API

# ── Supabase ─────────────────────────────────────────────────
# Local dev: run `supabase start` — values printed in CLI output
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ── Anthropic (Claude) ───────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX

# ── NVIDIA Nemotron ──────────────────────────────────────────
# https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXX
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-nano-8b-instruct

# ── eBay Browse API ──────────────────────────────────────────
# https://developer.ebay.com → My Apps → Create App Key
# Instant approval, no review required. App ID = Client ID.
EBAY_APP_ID=YourApp-YourName-PRD-XXXXXXXXXXXX
EBAY_CLIENT_SECRET=PRD-XXXXXXXXXXXXXXXXXXXX

# ── Twilio SMS ───────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── Next.js ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App Config ───────────────────────────────────────────────
# true = skip eBay, use api/fixtures/furniture_listings.json (great for dev)
MOCK_LISTINGS=false

MAX_UPLOAD_MB=10
LISTING_RADIUS_MILES=25

# ── ngrok ────────────────────────────────────────────────────
# After `ngrok http 8000`, paste the https URL here AND in Twilio Console
# Phone Numbers → Your number → Messaging → Webhook URL:
#   https://XXXX.ngrok-free.app/messages/webhook
PUBLIC_WEBHOOK_URL=https://XXXX.ngrok-free.app

# ── Supabase CLI (auto-filled by `supabase start`) ───────────
# DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
